<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutNotificationContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/white"
    android:layout_marginBottom="2dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_cart"
        app:tint="@color/primary_blue" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOrderNotifTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đặt hàng thành công"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvOrderNotifBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đơn hàng của bạn đang được xử lý..."
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvOrderNotifTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:30 15/04/2026"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:textColor="#999999" />
    </LinearLayout>
</LinearLayout>