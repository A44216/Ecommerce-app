<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:id="@+id/main"
    android:background="@color/background_light"
    tools:context=".ui.activity.home.seller.order.SellerOrderDetailActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- GROUP: HEADER -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- BACK -->
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/desc_image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- TITLE -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/seller_order_detail_title"
                android:textStyle="bold"
                android:textSize="24sp"
                android:layout_marginTop="24dp"
                android:gravity="center"
                app:layout_constraintStart_toEndOf="@id/ivBack"
                app:layout_constraintTop_toTopOf="@id/ivBack"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- ORDER ID -->
            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seller_order_detail_default_id"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- CREATED AT -->
            <TextView
                android:id="@+id/tvCreatedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seller_order_detail_default_created_at"
                android:textColor="@color/gray"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvOrderId"
                app:layout_constraintStart_toStartOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CARD: CUSTOMER + SHIPPING -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardOrderInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintTop_toBottomOf="@id/layoutHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <!-- CUSTOMER -->
                <TextView
                    android:id="@+id/tvCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/seller_order_detail_default_customer_name"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <!-- SHIPPING NAME -->
                <TextView
                    android:id="@+id/tvShippingName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/seller_order_detail_default_shipping_name"
                    android:layout_marginTop="6dp"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@id/tvCustomer"
                    app:layout_constraintStart_toStartOf="parent"/>

                <!-- PHONE -->
                <TextView
                    android:id="@+id/tvPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/seller_order_detail_default_shipping_phone"
                    android:layout_marginTop="4dp"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@id/tvShippingName"
                    app:layout_constraintStart_toStartOf="parent"/>

                <!-- ADDRESS -->
                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/seller_order_detail_default_shipping_address"
                    android:layout_marginTop="4dp"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@id/tvPhone"
                    app:layout_constraintStart_toStartOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- TOTAL -->
        <TextView
            android:id="@+id/tvOrderItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đơn hàng"
            android:textStyle="bold"
            android:textSize="24sp"
            android:padding="6dp"
            app:layout_constraintTop_toBottomOf="@id/cardOrderInfo"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- FRAGMENT -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrderItems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tvOrderItems"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:nestedScrollingEnabled="false"/>

        <!-- TOTAL -->
        <TextView
            android:id="@+id/tvTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/seller_order_detail_default_total_price"
            android:textStyle="bold"
            android:textColor="#E53935"
            android:textSize="24sp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/rvOrderItems"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- phần dưới giữ nguyên -->
        <!-- PAYMENT METHOD -->
        <TextView
            android:id="@+id/tvPaymentMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/seller_order_detail_default_payment_method"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalPrice"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvPaymentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/seller_order_detail_default_status"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvPaymentMethod"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrderStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvPaymentStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Xác nhận"
            android:textSize="16dp"
            android:backgroundTint="@color/black"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:padding="10dp"
            app:cornerRadius="4dp"
            app:layout_constraintTop_toBottomOf="@id/rvOrderStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>