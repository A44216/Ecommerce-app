<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="2dp">

    <CheckBox
        android:id="@+id/cbUserCart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/primary_blue" />

    <ImageView
        android:id="@+id/ivUserCartImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginStart="12dp">
        <TextView
            android:id="@+id/tvUserCartDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:text="Xóa"
            android:textColor="#FF3B30"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="4dp" />
        <TextView
            android:id="@+id/tvUserCartName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="2"
            android:text="Tên sản phẩm"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvUserCartPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="0đ"
            android:textColor="@color/primary_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:background="#F5F5F5"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnUserCartMinus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="-"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvUserCartQty"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="1" />

            <TextView
                android:id="@+id/btnUserCartPlus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>