<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".ui.fragment.admin.order.AdminOrderFragment">

    <!-- Search Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        app:boxBackgroundColor="@color/white"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actvSearch"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Tìm kiếm theo mã đơn, khách hàng, sdt"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:completionThreshold="1"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Filters Row -->
    <LinearLayout
        android:id="@+id/filterRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tilSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Sort Filter -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSortTime"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:boxBackgroundColor="@color/white"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_calendar">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvSortTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:hint="Sắp xếp"
                android:inputType="none"
                android:maxLines="1"
                android:text="Mới nhất"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filter Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilter"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bộ lọc"
            app:icon="@drawable/ic_filter_list"
            android:textColor="@color/black"
            app:strokeColor="@color/gray"
            android:backgroundTint="@color/white" />

    </LinearLayout>

    <!-- Tab Pending / Completed / .... -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabOrder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/filterRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        app:tabTextAppearance="@style/OrderTabTextAppearance"
        app:tabMode="scrollable"
        tools:ignore="SpeakableTextPresentCheck"/>

    <!-- ViewPager để slide mượt -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerOrder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tabOrder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>