<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ================= USER + PRODUCT ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- AVATAR -->
            <ImageView
                android:id="@+id/imgUserAvatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_user"
                android:scaleType="centerCrop" />

            <!-- USER + PRODUCT INFO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User name"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#222" />

                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product name"
                    android:textSize="12sp"
                    android:textColor="#777" />
            </LinearLayout>

            <!-- RATING -->
            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1"
                android:isIndicator="true"
                android:scaleX="0.7"
                android:scaleY="0.7" />
        </LinearLayout>

        <!-- ================= COMMENT ================= -->
        <TextView
            android:id="@+id/tvComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Comment content"
            android:textSize="14sp"
            android:textColor="#333" />

        <!-- ================= CREATED AT ================= -->
        <TextView
            android:id="@+id/tvCreatedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2026-04-08"
            android:textSize="12sp"
            android:textColor="#999" />

        <!-- ================= SELLER REPLY ================= -->
        <LinearLayout
            android:id="@+id/layoutSellerReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#F4F6F8"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reply from seller"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#333" />

            <TextView
                android:id="@+id/tvSellerReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seller reply here"
                android:textSize="13sp"
                android:textColor="#444"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvSellerReplyAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="reply time"
                android:textSize="11sp"
                android:textColor="#888"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ================= SELLER ACTION ================= -->
        <Button
            android:id="@+id/btnReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reply"
            android:textAllCaps="false"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- ================= HIDDEN IDS ================= -->
        <TextView
            android:id="@+id/tvReviewId"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUserId"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvProductId"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>