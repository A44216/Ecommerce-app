<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- PRODUCT CODE + STATUS (HEADER) -->
        <TextView
            android:id="@+id/tvProductCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="CODE_SP"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvProductStatus" />

        <TextView
            android:id="@+id/tvProductStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trạng thái"
            android:background="@drawable/bg_shop_status_pending"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="@color/orange"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvProductCode" />

        <!-- ICON / IMAGE (LEFT) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPathProduct"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:contentDescription="Ảnh sản phẩm"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            app:cornerFamily="rounded"
            app:cornerSize="8dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvProductCode" />

        <!-- RIGHT SIDE: PRODUCT NAME, SHOP, CATEGORY, SOLD & STOCK, PRICE -->
        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tên sản phẩm"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textColor="@color/blue"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toEndOf="@id/imgPathProduct"
            app:layout_constraintTop_toBottomOf="@id/tvProductCode"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- RIGHT SIDE: SHOP, CATEGORY, SOLD & STOCK, PRICE -->
        <TextView
            android:id="@+id/tvShopName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Shop: N/A"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tvProductName"
            app:layout_constraintTop_toBottomOf="@id/tvProductName"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvProductCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Danh mục: N/A"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tvShopName"
            app:layout_constraintTop_toBottomOf="@id/tvShopName"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSoldAndStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã bán: 0 | Kho: 0"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/gray"
            app:layout_constraintTop_toBottomOf="@id/tvProductCategory"
            app:layout_constraintStart_toStartOf="@id/tvShopName" />

        <TextView
            android:id="@+id/tvProductPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0đ"
            android:maxLines="1"
            android:gravity="end"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/red"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/tvShopName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSoldAndStock" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
