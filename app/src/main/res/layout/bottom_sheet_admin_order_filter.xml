<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bộ lọc đơn hàng"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Payment Method Filter -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPaymentMethod"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/white"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_order"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actvPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phương thức thanh toán"
            android:inputType="none"
            android:text="Tất cả"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Payment Status Filter -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPaymentStatus"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxBackgroundColor="@color/white"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_filter_list"
        app:layout_constraintTop_toBottomOf="@id/tilPaymentMethod">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actvPaymentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trạng thái thanh toán"
            android:inputType="none"
            android:text="Tất cả"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Shop Filter (Autocomplete) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilShop"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxBackgroundColor="@color/white"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_shop"
        app:endIconMode="clear_text"
        app:layout_constraintTop_toBottomOf="@id/tilPaymentStatus">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actvShop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Chọn cửa hàng (Tên, email hoặc sđt)"
            android:inputType="text"
            android:maxLines="1"
            android:completionThreshold="1"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Apply Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyFilter"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="Áp dụng"
        android:padding="10dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/black"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toBottomOf="@id/tilShop"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
