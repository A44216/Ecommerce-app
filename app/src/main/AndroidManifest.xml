        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EcommerceApp"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.activity.home.user.chat.UserConversationListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EcommerceApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.activity.home.user.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".ui.activity.home.user.review.ReviewActivity"
            android:exported="false"/>
        <activity
            android:name=".ui.activity.home.user.order.OrderDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.user.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.user.settings.ChangePasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.user.editprofile.EditUserProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.user.editprofile.ChangeEmailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activity.home.user.checkout.UserAddAddressActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.user.order.UserOrderHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.user.checkout.UserCheckoutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.user.cart.UserCartActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.user.product.UserProductDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.seller.product.ProductDetailActivity"
