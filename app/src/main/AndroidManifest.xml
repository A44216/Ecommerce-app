            android:exported="false" />
        <activity
            android:name=".ui.activity.home.SellerHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.home.AdminHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activity.home.user.search.UserSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysVisible"/>

        <activity
            android:name=".ui.activity.home.UserHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activity.login.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.login.ResetPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.login.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activity.login.LoginActivity"
            android:exported="false" />

    </application>

</manifest>